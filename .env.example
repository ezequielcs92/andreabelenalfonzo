# Public site URL. Used for SEO, canonical links and admin origin checks.
NEXT_PUBLIC_SITE_URL=https://example.com

# Canonical admin origin. Cloudflare Access protects this entire hostname.
ADMIN_SITE_URL=https://admin.example.com

# Cloudflare D1 (server-only) — used to persist gallery order and visibility.
# The token only needs D1 read/write permissions for this database.
CLOUDFLARE_ACCOUNT_ID=your_account_id
CLOUDFLARE_D1_DATABASE_ID=your_database_id
CLOUDFLARE_D1_API_TOKEN=your_api_token_with_d1_permission

# Cloudflare Access (server-only) — protects /admin and /api/admin/*.
# Team domain including the scheme, e.g. https://your-team.cloudflareaccess.com
CLOUDFLARE_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
# Application AUD tag from the Cloudflare Access policy.
CLOUDFLARE_ACCESS_AUD=your_access_aud
# Comma-separated list of emails allowed to use the admin panel.
ADMIN_ALLOWED_EMAILS=you@example.com
